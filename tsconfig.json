{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "preserveConstEnums": true,
    "strict": true,
    "strictNullChecks": false,
    "strictPropertyInitialization": false
