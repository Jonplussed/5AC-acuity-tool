  "files": [
    "main.ts",
    "modules/array.ts",
    "modules/bed.ts",
    "modules/assignment.ts",
    "modules/constraint.ts",
    "modules/patient.ts",
    "modules/roster.ts",
    "modules/status.ts",
    "modules/types.ts"
  ]
}
